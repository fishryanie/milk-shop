# Chỉ trên server. Dùng tài khoản MongoDB riêng, giới hạn các collection storefront_*.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=snowmilk
STOREFRONT_STORE_ID=milk-shop
# Production: https://caitiemsua.com (phải trùng origin trình duyệt đang mở).
STOREFRONT_ORIGIN=http://localhost:3200
# Sinh bằng: openssl rand -hex 32
STOREFRONT_SESSION_SECRET=
# Server seed/setup dùng tài khoản migration riêng nếu runtime không có quyền tạo index.
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Thông báo đơn mới vào nhóm Zalo. Chỉ đặt trên server.
ZALO_BOT_TOKEN=
ZALO_GROUP_ID=
